# ============================================================
# VK AI Assistant — пример конфигурации.
# Скопируйте файл в .env и заполните значения.
# .env не попадает в git.
# ============================================================

# --- VK ---
# Ключ доступа сообщества (Управление -> Работа с API -> Ключи доступа).
# Нужны права: messages, manage (для LongPoll достаточно messages).
VK_GROUP_TOKEN=
# ID сообщества. Если пусто — vkbottle определит автоматически.
VK_GROUP_ID=

# --- ProxyAPI ---
# Ключ из личного кабинета ProxyAPI.
PROXY_API_KEY=
# Базовый URL без /v1 и /v1beta: SDK добавит нужный путь сам.
PROXY_BASE_URL=https://api.proxyapi.ru

# --- LLM ---
# gemini — финальный режим (Google GenAI SDK).
# openai — дешёвый режим настройки (OpenAI-совместимый API).
AI_PROVIDER=openai

# Модели Gemini (короткие имена для нативного /v1beta).
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Модели OpenAI-совместимого API (полные имена каталога ProxyAPI).
OPENAI_MODEL=openai/gpt-4.1-mini
OPENAI_FALLBACK_MODEL=deepseek/deepseek-chat

TEMPERATURE=0.6
MAX_OUTPUT_TOKENS=1200
REQUEST_TIMEOUT=90

# --- MCP-хранилище ---
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp
# Если не задано — собирается из HOST/PORT/PATH.
MCP_URL=
MCP_TIMEOUT=30
DATA_DIR=data/users
# JSON-анкеты из режима «Анкетирование» (отдельно от профилей).
QUESTIONNAIRE_DIR=data/questionnaires
# Заявки, после которых бот запускает анкетирование.
LEAD_DIR=data/leads
# Куда складывать готовые PDF (scripts/make_profile.py).
REPORT_DIR=reports

# --- Память и лимиты ---
HISTORY_LIMIT=100
HISTORY_MAX_CHARS=14000
MAX_DIALOGS=20
MAX_MESSAGE_CHARS=3800

# --- База знаний (RAG) ---
# Режим «Менеджер по базе знаний»: бот отвечает по загруженным файлам.
# Индексация: python scripts/rag_index.py --add <файл>
RAG_ENABLED=true
# Эмбеддинговая модель ProxyAPI (дешёвая и качественная — text-embedding-3-small).
EMBEDDING_MODEL=openai/text-embedding-3-small
# Сколько фрагментов базы подмешивать в контекст (1-10).
RAG_TOP_K=5

# --- Логи ---
LOG_LEVEL=INFO
LOG_FILE=data/bot.log
